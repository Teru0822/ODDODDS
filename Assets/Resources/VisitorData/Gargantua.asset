        lineJp: "\u3066\u3081\u3048\u3067\u904A\u3076\u4EE3\u308F\u308A\u306B\u304A\u99C4\u8CC3\u3092\u3084\u308B\u3002\u904A\u3076\u3068\u304D\u306B\u91D1\u3092\u5165\u308C\u30F3\u306E\u306F\u8CED\u535A\u5834\u3058\u3083\u30DE\u30CA\u30FC\u3060\u304B\u3093\u306A\u3002"
