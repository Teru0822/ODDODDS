        lineJp: "\u3069\u3046\u3084\u3089\u30A2\u30AF\u30DE\u306E\u91CE\u90CE\u3001\u307E\u305F\u9762\u767D\u305D\u3046\u306A\u3053\u3068\u3092\u3057\u3066\u308B\u3089\u3057\u3044\u3058\u3083\u306D\u3047\u304B"
