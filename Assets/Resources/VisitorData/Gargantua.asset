        lineEn: 
      - animation: 0
        lineJp: "\u2026\u3042\u3041\uFF1F\u3066\u3081\u3048\u306E\u610F\u898B\u306A\u3093\u305E\u805E\u304B\u306D\u3048\u3088\u3002\u304A\u3082\u3061\u3083\u306B\u62D2\u5426\u6A29\u304C\u3042\u308B\u3068\u601D\u3063\u3066\u3093\u306E\u304B\u3002"
