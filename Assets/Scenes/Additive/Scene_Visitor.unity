    _dicElements:
    - Key: CanTradeText
      Value:
      - animation: 0
        lineJp: "\u53D6\u5F15\u306B\u5FDC\u3058\u308B\u3053\u3068\u306F\u3067\u304D\u305D\u3046\u3060\u304C...\u3069\u3046\u3057\u3088\u3046\u304B..."
